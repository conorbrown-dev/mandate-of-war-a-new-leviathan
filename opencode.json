{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "doom_loop": "deny"
  },
  "lsp": {
    "clangd": {
      "command": [
        "/usr/bin/clangd",
        "--background-index",
        "--compile-commands-dir=build"
      ],
      "extensions": [
        ".c",
        ".cc",
        ".cpp",
        ".cxx",
        ".h",
        ".hh",
        ".hpp",
        ".hxx"
      ]
    },
    "gdscript": {
      "command": [
        "/usr/bin/nc",
        "127.0.0.1",
        "6005"
      ],
      "extensions": [
        ".gd"
      ]
    }
  }
}
